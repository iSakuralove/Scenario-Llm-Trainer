# 排查工坊 HiddenWorld Agent —— 环境变量样例
#
# 复制为 .env 后填入真实值。**真实凭证永远不提交。**
# .gitignore 已忽略 .env，只放行 .env.example。

# ---- 服务 ----
HIDDENWORLD_HOST=0.0.0.0
HIDDENWORLD_PORT=8090

# 单轮总 deadline。网络重试也受它约束，不允许重试把一轮拖到超时之外。
HIDDENWORLD_TURN_DEADLINE_MS=15000

# 单元测试默认置 0，禁止任何真实模型请求。
# 只有 Provider Contract Test（pytest -m live）会显式置 1。
HIDDENWORLD_ALLOW_MODEL_REQUESTS=0

# ---- DeepSeek ----
# 兼容保留；当前单 Agent 默认使用 GLM-5.3，失败时显式回退到 GLM-4.7。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Z.AI / GLM ----
# 单 Agent 默认走原生 ZaiModel + ZaiProvider；GLM-5.3 的 low 会透传
# reasoning_effort，回退模型只保留 thinking 开关。
# 不要用通用 OpenAIChatModel 代替 ZaiModel：后者负责 Z.AI 的 thinking 参数
# 和历史 reasoning_content 转换。
# 可使用 GLM_API_KEY / GLM_BASE_URL 兼容项目根目录的 GLM 配置；优先使用 ZAI_*。
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-5.3
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODEL=glm-5.3
GLM_FALLBACK_MODEL=glm-4.7
GLM_THINKING=low

# 测试环境显式打开后，/turn/stream 会增加 reasoning_raw_delta 调试事件；
# Go 正式客户端忽略该事件，AgentTurnResult 与会话历史不会保存原始思维链。
HIDDENWORLD_TEST_STREAM_RAW_REASONING=0

# ---- 宣安 OpenAI 兼容中转站 ----
# 仅用于兼容性验证；填入 XUAN_API_KEY 后可切换已验证模型分别测试。
XUAN_BASE_URL=https://ai.centos.hk/v1
XUAN_API_KEY=
XUAN_MODEL=gpt-5.6-terra

# ---- 角色到模型的绑定 ----
# TurnInterpreter 是连接任务 + 小输出，快比强重要。
# Mentor 的语言质量直接决定体验。
HIDDENWORLD_INTERPRETER_PROVIDER=glm
HIDDENWORLD_MENTOR_PROVIDER=glm
