{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hiddenworld_question",
  "title": "hiddenworld_question",
  "description": "hiddenworld.v1 scenario generation JSON Schema",
  "x-version": "hiddenworld.v1",
  "x-task": "SC-03",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "description", "domain", "difficulty", "scenario_type", "tags", "content"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "difficulty": {"type": "string", "enum": ["L1", "L2", "L3", "L4", "L5"]},
    "scenario_type": {"type": "string", "enum": ["troubleshooting", "design", "performance"]},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "content": {"$ref": "#/$defs/content"}
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_version", "public_scenario", "hidden_world"],
      "properties": {
        "model_version": {"type": "string", "enum": ["hiddenworld.v1"]},
        "public_scenario": {"$ref": "#/$defs/public_scenario"},
        "hidden_world": {"$ref": "#/$defs/hidden_world"}
      }
    },
    "public_scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "environment", "initial_symptoms", "architecture_diagram"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "environment": {"type": "string"},
        "initial_symptoms": {"type": "array", "items": {"type": "string"}},
        "architecture_diagram": {
          "type": "string",
          "description": "AI 输出必须保持为空字符串；后端用 architecture_diagram_spec 确定性渲染最终 Mermaid。"
        },
        "architecture_diagram_spec": {"$ref": "#/$defs/diagram_spec"}
      }
    },
    "diagram_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "nodes", "edges"],
      "properties": {
        "direction": {"type": "string", "enum": ["TD", "LR"]},
        "nodes": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/diagram_node"}},
        "edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/diagram_edge"}}
      }
    },
    "diagram_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"},
        "label": {"type": "string", "minLength": 1}
      }
    },
    "diagram_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"},
        "to": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,31}$"},
        "label": {"type": "string"},
        "style": {"type": "string", "enum": ["solid", "dotted"]}
      }
    },
    "hidden_world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_cause", "hypotheses", "evidence_graph", "observations", "solution_rubric", "misconception_rules"],
      "properties": {
        "root_cause": {"$ref": "#/$defs/root_cause"},
        "hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hypothesis"}},
        "evidence_graph": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
        "virtual_tools": {"type": "array", "items": {"$ref": "#/$defs/virtual_tool"}},
        "solution_rubric": {"$ref": "#/$defs/rubric"},
        "misconception_rules": {"type": "array", "items": {"$ref": "#/$defs/misconception"}}
      }
    },
    "root_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "component", "description", "sufficient_evidence_sets", "accepted_hypotheses", "solution_requirements"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["logs", "metrics", "data", "change", "resource", "dependency", "behavior"]},
        "component": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "sufficient_evidence_sets": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
        "accepted_hypotheses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "solution_requirements": {"type": "array", "items": {"type": "string"}}
      }
    },
    "hypothesis": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis_id", "label"],
      "properties": {"hypothesis_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "content", "category", "prerequisites", "obtained_by"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["logs", "metrics", "data", "change", "resource", "dependency", "behavior"]},
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "obtained_by": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "result", "is_negative", "yields_evidence", "rules_out", "unmet_prerequisite_result"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "result": {"type": "string", "minLength": 1},
        "is_negative": {"type": "boolean"},
        "yields_evidence": {"type": "array", "items": {"type": "string"}},
        "rules_out": {"type": "array", "items": {"type": "string"}},
        "unmet_prerequisite_result": {"type": "string"}
      }
    },
    "virtual_tool": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_id", "kind", "target", "aliases", "query_patterns", "redacted_parameters", "simulated_output", "observation_action", "evidence_ids"],
      "properties": {
        "tool_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["logs", "config", "metrics", "database", "dependency"]},
        "target": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}},
        "query_patterns": {"type": "array", "items": {"type": "string"}},
        "redacted_parameters": {"type": "array", "items": {"type": "string"}},
        "simulated_output": {"type": "string", "minLength": 1},
        "observation_action": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "rubric": {
      "type": "object", "additionalProperties": false,
      "required": ["required_actions", "verification_steps", "rollback_notes"],
      "properties": {
        "required_actions": {"type": "array", "items": {"type": "string"}},
        "verification_steps": {"type": "array", "items": {"type": "string"}},
        "rollback_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "misconception": {
      "type": "object", "additionalProperties": false,
      "required": ["misconception_id", "pattern_hypotheses", "why_wrong"],
      "properties": {
        "misconception_id": {"type": "string", "minLength": 1},
        "pattern_hypotheses": {"type": "array", "items": {"type": "string"}},
        "why_wrong": {"type": "string", "minLength": 1}
      }
    }
  }
}
